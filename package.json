{
  "name": "offshore-engineering-studio",
  "version": "0.5.0",
  "private": true,
  "description": "Client-side offshore hydrodynamic load analysis (Morison arrays, Airy / Stokes 5th, MacCamy-Fuchs) evolving toward an offshore engineering simulation studio.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/unit/**/*.test.ts\"",
    "test:e2e": "npm run build:studio && playwright test",
    "test:all": "npm test && npm run test:e2e",
    "build:css": "tailwindcss -c tailwind.config.cjs -i css/tailwind.input.css -o css/app.css --minify",
    "serve": "node scripts/serve.mjs",
    "bench": "node scripts/bench.mjs",
    "studio": "vite --config studio/vite.config.ts",
    "build:studio": "vite build --config studio/vite.config.ts",
    "typecheck": "tsc -p studio/tsconfig.json",
    "bench:studio": "node scripts/bench-studio.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "4.3.4",
    "jspdf": "4.2.1",
    "plotly.js-dist-min": "2.35.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "6.4.3"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rhino3dm": "8.17.0",
    "three": "0.160.0"
  }
}
